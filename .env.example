# ---------------------------------------------------------------------------
# CV ATS Intelligence — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="CV Intelligence <reports@yourdomain.com>"

# Public base URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI enrichment. "none" keeps the product fully functional
# using the deterministic scoring engine alone.
# Supported: none | openai | anthropic
CV_AI_PROVIDER=none
# CV_AI_API_KEY=
# CV_AI_MODEL=

# Original uploaded file retention: temporary | persistent
# temporary => parse, keep extracted text, delete the original file.
CV_FILE_RETENTION_MODE=temporary

# Checkout URL for the paid CV optimisation service
NEXT_PUBLIC_CV_SERVICE_CHECKOUT_URL=https://your-checkout-provider.com/cv-optimization
# Payment provider adapter: manual | stripe | lemonsqueezy | tap | moyasar
PAYMENT_PROVIDER=manual
# PAYMENT_WEBHOOK_SECRET=

# Admin dashboard access — must match the Supabase Auth user's email
ADMIN_EMAIL=you@yourdomain.com

# Rate limiting (analyses per IP per hour)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
